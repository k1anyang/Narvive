    <!-- Privacy policy -->
    <string name="legal_privacy_title">Privacy policy</string>
    <string name="legal_updated_at">Last updated: %1$s</string>
    <string name="legal_privacy_h1">Where your data lives</string>
    <string name="legal_privacy_b1">Book files, reading progress, bookmarks, highlights, notes, translations, AI conversations and all settings are stored only on your device. Narvive has no account system and no server that holds your content.</string>
    <string name="legal_privacy_h2">What we do not collect</string>
    <string name="legal_privacy_b2">We require no sign-up or login, collect no personally identifying information such as names or contact details, and embed no usage analytics.</string>
    <string name="legal_privacy_h3">AI features</string>
    <string name="legal_privacy_b3">AI is one of the app\'s network endpoints and works in BYOK (bring your own key) mode: requests go from your device straight to the AI provider you configure. Narvive does not relay or log conversations. The scope of text being sent is always shown in the interface. API keys are stored with system-level encryption, stay on your device, and never enter backups or logs.</string>
    <string name="legal_privacy_h4">Network usage</string>
    <string name="legal_privacy_b4">Apart from the AI requests you configure, font catalogue downloads and WebDAV sync, the app performs no other network communication. WebDAV credentials are likewise encrypted on-device, and synced files are uploaded only to the server you specify.</string>
    <string name="legal_privacy_h5">File access</string>
    <string name="legal_privacy_b5">File access is used solely to import book files you explicitly pick. The app reads only the selected files and keeps a copy in its private directory.</string>
    <string name="legal_privacy_h6">Backup and export</string>
    <string name="legal_privacy_b6">You choose where backup ZIPs and note exports are saved. Backup archives contain no API keys or WebDAV credentials.</string>
    <string name="legal_privacy_h7">Contact</string>
    <string name="legal_privacy_b7">If you have questions about this policy, reach us through the app store listing or the project page.</string>

    <!-- Terms of use -->
    <string name="legal_terms_title">Terms of use</string>
    <string name="legal_terms_h1">Licence to use</string>
    <string name="legal_terms_b1">Narvive grants you the right to use all features of this app on your personal devices, provided you comply with these terms.</string>
    <string name="legal_terms_h2">Content copyright</string>
    <string name="legal_terms_b2">Import only books and documents you have the legal right to read. The app offers local reading, annotation and note-taking; it provides no means of obtaining content.</string>
    <string name="legal_terms_h3">AI-generated content</string>
    <string name="legal_terms_b3">AI answers, translations, rewrites and role-play output are produced by third-party services and may be inaccurate or biased. They are for reference only and you must judge their suitability yourself. Use of those services is also governed by the provider\'s own terms.</string>
    <string name="legal_terms_h4">Cloud sync</string>
    <string name="legal_terms_b4">You configure the WebDAV server yourself. Keep your credentials safe and comply with that server\'s storage rules.</string>
    <string name="legal_terms_h5">Disclaimer</string>
    <string name="legal_terms_b5">This app is provided “as is”. We make every effort to avoid data or content loss caused by mistakes, device failure or third-party outages, but cannot accept liability beyond what the law allows. Export backups regularly.</string>
    <string name="legal_terms_h6">Changes to these terms</string>
    <string name="legal_terms_b6">We may update these terms and the privacy policy; updates will be published on this page. Continued use means you accept the revised terms.</string>

