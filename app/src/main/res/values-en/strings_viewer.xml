<?xml version="1.0" encoding="utf-8"?>
<!--
  Reader viewer strings (English).
  Key set and order must match values/strings_viewer.xml and values-b+zh+Hant/strings_viewer.xml.
  Used by EpubViewer / TxtViewer / TxtPagedViewer; all keys share the viewer_ prefix.
-->
<resources>
    <!-- Chapter label (TXT scroll / TXT paged) -->
    <string name="viewer_chapter_label">Chapter %1$d</string>

    <!-- Loading and errors (EPUB) -->
    <string name="viewer_loading_book">Parsing book…</string>
    <string name="viewer_error_file_not_found">File not found: %1$s</string>
    <string name="viewer_error_epub_parse">Failed to parse the EPUB. Please check that the file format is correct.</string>
    <string name="viewer_error_epub_open">Failed to open the EPUB: %1$s</string>
    <string name="viewer_error_init">Failed to initialize the reader: %1$s</string>

    <!-- Image preview (EPUB long-press on an image) -->
    <string name="viewer_image_content_description">Image</string>
    <string name="viewer_action_close">Close</string>
    <string name="viewer_action_save">Save</string>
    <string name="viewer_action_share">Share</string>
    <string name="viewer_image_saved">Saved to the gallery</string>
    <string name="viewer_image_save_failed">Failed to save</string>
    <string name="viewer_share_image_title">Share image</string>
</resources>
