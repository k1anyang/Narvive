<?xml version="1.0" encoding="utf-8"?>
<!--
  界面语言支持列表（Android 13+ 的「设置 → 应用 → Narvive → 语言」由系统读取本文件）。

  与 values/ 资源目录的对应关系：
  - zh-Hans → values/                （默认，简体中文）
  - en      → values-en/             （English）
  - zh-Hant → values-b+zh+Hant/      （繁體中文）

  新增语言时本文件与 docs/i18n.md 的清单需同步更新。
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="zh-Hans" />
    <locale android:name="zh-Hant" />
    <locale android:name="en" />
</locale-config>
