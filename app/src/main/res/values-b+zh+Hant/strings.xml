    <!-- 隱私權政策 -->
    <string name="legal_privacy_title">隱私權政策</string>
    <string name="legal_updated_at">更新日期：%1$s</string>
    <string name="legal_privacy_h1">資料儲存</string>
    <string name="legal_privacy_b1">書籍檔案、閱讀進度、書籤、螢光標記、筆記、翻譯、AI 對話紀錄與全部設定均只保存在你的裝置本機。Narvive 沒有帳號系統，也沒有營運伺服器存放你的內容。</string>
    <string name="legal_privacy_h2">我們不收集什麼</string>
    <string name="legal_privacy_b2">我們不要求註冊或登入，不收集姓名、聯絡方式等個人身分資訊，也不埋設使用者行為統計。</string>
    <string name="legal_privacy_h3">AI 功能</string>
    <string name="legal_privacy_b3">AI 是應用程式的網路出口之一，採用 BYOK（自備 Key）模式：請求由你的裝置直接送往你自行設定的 AI 服務商，Narvive 不中轉、不記錄對話內容。每次傳送的正文範圍會在介面中明示。API Key 使用系統加密儲存，只保存在本機，不進入備份包與紀錄。</string>
    <string name="legal_privacy_h4">網路使用</string>
    <string name="legal_privacy_b4">除你主動設定的 AI 請求、字型目錄下載與 WebDAV 雲端同步外，應用程式不會進行其他網路通訊。WebDAV 憑證同樣加密保存在本機，同步檔案只上傳至你指定的伺服器。</string>
    <string name="legal_privacy_h5">檔案存取</string>
    <string name="legal_privacy_b5">檔案存取權限僅用於匯入你主動選擇的書籍檔案；應用程式只讀取所選檔案並將其副本保存在應用程式私有目錄中。</string>
    <string name="legal_privacy_h6">備份與匯出</string>
    <string name="legal_privacy_b6">備份 ZIP 與筆記匯出均由你選擇儲存位置。備份包不包含任何 API Key 或 WebDAV 憑證。</string>
    <string name="legal_privacy_h7">聯絡我們</string>
    <string name="legal_privacy_b7">如對本政策有疑問，可透過應用程式商店或專案首頁回饋。</string>

    <!-- 使用者條款 -->
    <string name="legal_terms_title">使用者條款</string>
    <string name="legal_terms_h1">使用授權</string>
    <string name="legal_terms_b1">Narvive 授權你在遵守本條款的前提下，於個人裝置上使用本應用程式的全部功能。</string>
    <string name="legal_terms_h2">內容版權</string>
    <string name="legal_terms_b2">請僅匯入你擁有合法權利閱讀的書籍與文件。應用程式提供本機閱讀、標註與筆記功能，不提供任何內容的取得管道。</string>
    <string name="legal_terms_h3">AI 生成內容</string>
    <string name="legal_terms_b3">AI 回答、翻譯、改寫與角色扮演等輸出由第三方服務生成，可能不準確或存在偏差，僅供參考。你應自行判斷其適用性；相關服務的使用同時受該服務商條款約束。</string>
    <string name="legal_terms_h4">雲端同步</string>
    <string name="legal_terms_b4">WebDAV 同步由你自行設定伺服器，請妥善保管憑證，並遵守伺服器的儲存規範。</string>
    <string name="legal_terms_h5">免責聲明</string>
    <string name="legal_terms_b5">本應用程式依「現狀」提供。對於因誤操作、裝置故障、第三方服務無法使用等導致的資料或內容損失，我們盡力避免但無法承擔超出法律允許範圍的責任。建議定期匯出備份。</string>
    <string name="legal_terms_h6">條款變更</string>
    <string name="legal_terms_b6">我們可能更新本條款與隱私權政策，更新後將在本頁面公告。繼續使用即視為接受更新後的條款。</string>

