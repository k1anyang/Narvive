    <!-- 隐私政策 -->
    <string name="legal_privacy_title">隐私政策</string>
    <string name="legal_updated_at">更新日期：%1$s</string>
    <string name="legal_privacy_h1">数据存储</string>
    <string name="legal_privacy_b1">书籍文件、阅读进度、书签、高亮、笔记、翻译、AI 对话记录与全部配置均只保存在你的设备本地。Narvive 没有账号体系，也没有运营服务器存放你的内容。</string>
    <string name="legal_privacy_h2">我们不收集什么</string>
    <string name="legal_privacy_b2">我们不要求注册或登录，不收集姓名、联系方式等个人身份信息，也不埋设用户行为统计。</string>
    <string name="legal_privacy_h3">AI 功能</string>
    <string name="legal_privacy_b3">AI 是应用的网络出口之一，采用 BYOK（自带 Key）模式：请求由你的设备直接发往你自行配置的 AI 服务商，Narvive 不中转、不记录对话内容。每次发送的正文范围会在界面中明示。API Key 使用系统加密存储，只保存在本机，不进入备份包与日志。</string>
    <string name="legal_privacy_h4">网络使用</string>
    <string name="legal_privacy_b4">除你主动配置的 AI 请求、字体目录下载与 WebDAV 云同步外，应用不会进行其他网络通信。WebDAV 凭据同样加密保存在本机，同步文件只上传至你指定的服务器。</string>
    <string name="legal_privacy_h5">文件访问</string>
    <string name="legal_privacy_b5">文件访问权限仅用于导入你主动选择的书籍文件；应用只读取所选文件并将其副本保存在应用私有目录中。</string>
    <string name="legal_privacy_h6">备份与导出</string>
    <string name="legal_privacy_b6">备份 ZIP 与笔记导出均由你选择保存位置。备份包不包含任何 API Key 或 WebDAV 凭据。</string>
    <string name="legal_privacy_h7">联系我们</string>
    <string name="legal_privacy_b7">如对本政策有疑问，可通过应用商店或项目主页反馈。</string>

    <!-- 用户协议 -->
    <string name="legal_terms_title">用户协议</string>
    <string name="legal_terms_h1">使用许可</string>
    <string name="legal_terms_b1">Narvive 授权你在遵守本协议的前提下，于个人设备上使用本应用的全部功能。</string>
    <string name="legal_terms_h2">内容版权</string>
    <string name="legal_terms_b2">请仅导入你拥有合法权利阅读的书籍与文档。应用提供本地阅读、标注与笔记功能，不提供任何内容的获取渠道。</string>
    <string name="legal_terms_h3">AI 生成内容</string>
    <string name="legal_terms_b3">AI 回答、翻译、改写与角色扮演等输出由第三方服务生成，可能不准确或存在偏差，仅供参考。你应自行判断其适用性；相关服务的使用同时受相应服务商条款约束。</string>
    <string name="legal_terms_h4">云同步</string>
    <string name="legal_terms_b4">WebDAV 同步由你自行配置服务器，请妥善保管凭据，并遵守服务器的存储规范。</string>
    <string name="legal_terms_h5">免责声明</string>
    <string name="legal_terms_b5">本应用按“现状”提供。对于因误操作、设备故障、第三方服务不可用等导致的数据或内容损失，我们尽力避免但无法承担超出法律允许范围的责任。建议定期导出备份。</string>
    <string name="legal_terms_h6">协议变更</string>
    <string name="legal_terms_b6">我们可能更新本协议与隐私政策，更新后将在本页面公示。继续使用即视为接受更新后的条款。</string>

