<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读视图（EPUB / TXT）注入文案（简体中文 = 默认语言）。
  三语文件的 key 集合与顺序必须完全一致。
  这些文案由 EpubViewer / TxtViewer / TxtPagedViewer 使用，前缀统一为 viewer_。
-->
<resources>
    <!-- 章节标签（TXT 滚动 / TXT 分页） -->
    <string name="viewer_chapter_label">第 %1$d 章</string>

    <!-- 加载与错误（EPUB） -->
    <string name="viewer_loading_book">正在解析书籍…</string>
    <string name="viewer_error_file_not_found">文件不存在：%1$s</string>
    <string name="viewer_error_epub_parse">EPUB 解析失败，请确认文件格式正确</string>
    <string name="viewer_error_epub_open">EPUB 打开异常：%1$s</string>
    <string name="viewer_error_init">阅读器初始化失败：%1$s</string>

    <!-- 图片预览（EPUB 长按图片） -->
    <string name="viewer_image_content_description">图片</string>
    <string name="viewer_action_close">关闭</string>
    <string name="viewer_action_save">保存</string>
    <string name="viewer_action_share">分享</string>
    <string name="viewer_image_saved">已保存到相册</string>
    <string name="viewer_image_save_failed">保存失败</string>
    <string name="viewer_share_image_title">分享图片</string>
</resources>
