    <string name="lib_vm_md_translation">译文：%1$s</string>
    <string name="lib_vm_md_rewrite">改写（%1$s）：</string>

    <!-- BookDetailsViewModel · 笔记类型标签（导出 Markdown 的 ## 标题） -->
    <string name="lib_vm_type_highlight">高亮</string>
    <string name="lib_vm_type_note">笔记</string>
    <string name="lib_vm_type_translation">翻译</string>
    <string name="lib_vm_type_ai_answer">AI 保存</string>
