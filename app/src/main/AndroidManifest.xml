<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NarviveApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Narvive"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Narvive"
            android:windowSoftInputMode="adjustResize">
            <!--
              界面语言切换依赖 AppCompat / 系统的**官方重建行为**：不声明 locale 的
              configChanges，因此系统会销毁并重建本 Activity。

              为什么不拦截重建（曾实现过 `configChanges="locale|layoutDirection"`）：
              拦截后确实不再闪烁，但代价是「凡把本地化文案缓存进 ViewModel 的地方
              都要自己记得刷新」，属分散且静默的维护负担。改为官方重建后 ViewModel 随
              Activity 重建，文案刷新由框架保证，维护成本更低、也更符合官方推荐。

              已知代价：重建瞬间系统会绘制一帧空窗口，表现为「浅色闪黑、深色闪白」。
              这一帧无法用 windowBackground 或淡入遮盖（都只能影响重建**之后**的帧），
              属系统行为，不要再试图消除，也不要为此改回拦截重建。
              唯一有效的缓解是「让首帧与主题同色」：见 res/values/themes.xml、
              res/values-night/colors.xml，以及 ui/theme/Theme.kt 的窗口背景同步。

              因为依赖重建，**所有用户可见文案必须走 resources**。详见
              CONTRIBUTING.md 的本地化规范与 docs/i18n.md §2.1。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收系统「打开方式 / 分享」导入书籍 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
